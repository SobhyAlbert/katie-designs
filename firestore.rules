rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'CQujCJMlRfP8nG5lAlwYVeo69OH2';
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function validCommission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','email','artworkType','size','description','deadline','budget','status','createdAt','source'])
        && d.keys().hasAll(['name','email','artworkType','description','status','createdAt','source'])
        && str(d.name, 1, 100)
        && str(d.email, 3, 200) && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && str(d.artworkType, 1, 40)
        && str(d.description, 1, 3000)
        && (!('size' in d) || str(d.size, 0, 100))
        && (!('deadline' in d) || str(d.deadline, 0, 10))
        && (!('budget' in d) || d.budget == null || (d.budget is number && d.budget >= 0 && d.budget <= 1000000))
        && d.status == 'new'
        && d.source == 'web'
        && d.createdAt == request.time;
    }
    match /commissions/{id} {
      allow create: if isOwner() || validCommission();
      allow read, update, delete: if isOwner();
    }
    match /artworks/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
